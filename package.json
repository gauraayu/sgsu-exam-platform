{
  "name": "sgsu-exam-portal",
  "version": "1.0.0",
  "private": true,
  "description": "SGSU Smart Assessment Portal — online examination & assessment platform for Scope Global Skills University, Bhopal",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/generate-asset-manifest.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "seed:admin": "tsx --conditions=react-server scripts/create-admin.ts",
    "import:local": "tsx --conditions=react-server scripts/import-local-questions.ts",
    "assets:manifest": "tsx scripts/generate-asset-manifest.ts",
    "load-test": "tsx scripts/load-test.ts",
    "generate:questions": "tsx scripts/generate-question-bank.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "mongoose": "^9.12.1",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.0",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
